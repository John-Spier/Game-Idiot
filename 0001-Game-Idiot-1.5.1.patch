+const char* TypeColor(u_char type)
+{
+	switch(type)
+	{
+		case MUSIC_MOD:
+		case MUSIC_XM:
+		case MUSIC_NEWSEQ:
+		case MUSIC_SEQONLY:
+		case MUSIC_PARAMS:
+		case MUSIC_XA:
+		case MUSIC_XA1X:
+		case MUSIC_XA2X:
+		case MUSIC_DA:
+		case MUSIC_VAG:
+			return "~c088"; //CYAN - MUSIC
+		case MUSIC_TIM:
+			return "~c044"; //CYAN - TIM
+		case MUSIC_STR:
+		case MUSIC_STR1X:
+		case MUSIC_STR2X:
+			return "~c080"; //GREEN - VIDEO
+		case MUSIC_EXE:
+		case MUSIC_NEWEXE:
+		case MUSIC_ZEROEXE:
+		case MUSIC_CNF:
+			return "~c808"; //MAGENTA - EXE
+		case MENU_DIR:
+		case MENU_LASTDIR:
+			return "~c880"; //YELLOW - DIRECTORY
+		case MENU_DA:
+		case MENU_XA:
+		case MENU_XA1X:
+		case MENU_XA2X:
+		case MENU_VFS:
+		case MENU_VFSBYTE:
+		case MENU_VFSSECTOR:
+		case MENU_TXT:
+		case MENU_TXTLOSER:
+		case MENU_TXTPSF:
+		case MENU_TXTPIMP:
+			return "~c440"; //YELLOW - PACKED DIRECTORY	
+		default:
+			return "~c888"; //MAKES SPACE OTHERWISE
+	}
+	return ""; //NONE (WHITE) - OTHER
+}
